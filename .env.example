CONSTRUCTION_OS_ENVIRONMENT=local
CONSTRUCTION_OS_SECRET_KEY=replace-with-at-least-32-random-characters
CONSTRUCTION_OS_DATABASE_URL=postgresql+asyncpg://construction:construction@db:5432/construction
CONSTRUCTION_OS_REDIS_URL=redis://redis:6379/0
CONSTRUCTION_OS_LOG_LEVEL=INFO
CONSTRUCTION_OS_DOCUMENT_STORAGE_PATH=/var/lib/construction-os/documents
CONSTRUCTION_OS_MAX_DOCUMENT_SIZE_MB=20
